# ----------------------------------------------------------------- actions ---
do_hostname() {
    n="$1"
    echo "$n" | grep -qE '^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$' || return 1
    backup "$HOSTFILE"; echo "$n" > "$HOSTFILE"
    [ -z "${GALILEOSETUP_ETC:-}" ] && hostname "$n" 2>/dev/null
    return 0
}

do_password() {
    if [ -n "${GALILEOSETUP_ETC:-}" ]; then
        printf '%s\n' "$1" > "$ETC/.password-en-prueba"; chmod 600 "$ETC/.password-en-prueba" 2>/dev/null
        return 0
    fi
    printf '%s\n' "root:$1" | chpasswd 2>/dev/null || return 1
    return 0
}

do_timezone() {   # $1 = IANA zone (ya validada por el selector)
    zone="$1"
    [ -e "$ZONEINFO/$zone" ] || return 1
    ensure_dir "$TZFILE"
    echo "$zone" > "$TZFILE"
    if [ -z "${GALILEOSETUP_ETC:-}" ]; then
        rm -f "$LOCALTIME" 2>/dev/null
        ln -s "$ZONEINFO/$zone" "$LOCALTIME" 2>/dev/null || cp -f "$ZONEINFO/$zone" "$LOCALTIME" 2>/dev/null
    fi
    TZ="$zone"; export TZ
    return 0
}

do_wifi() {   # $1 ssid, $2 psk, $3 ip|dhcp
    ensure_dir "$WPA"; backup "$WPA"
    [ -f "$WPA" ] || printf 'ctrl_interface=/var/run/wpa_supplicant\nupdate_config=1\n' > "$WPA"
    _t="$WPA.new.$$"
    wpa_passphrase "$1" "$2" | grep -v '^[[:space:]]*#psk=' > "$_t"
    cat "$_t" >> "$WPA"; rm -f "$_t"; chmod 600 "$WPA" 2>/dev/null
    if [ "${3:-dhcp}" = dhcp ] || [ -z "${3:-}" ]; then
        set_iface wlan0 dhcp "" "" ""
    else
        set_iface wlan0 static "$3" "255.255.255.0" ""
    fi
    return 0
}

set_iface() {   # $1 iface, $2 dhcp|static, $3 ip, $4 subnet, $5 gw
    iface="$1"; mode="$2"
    ensure_dir "$IFACES"; [ -f "$IFACES" ] || : > "$IFACES"
    tmp="$IFACES.new.$$"
    awk -v I="$iface" '
        $1=="auto" && $2==I {next}
        $1=="iface" && $2==I {skip=1; next}
        skip && /^[ \t]/ {next}
        skip && NF==0 {skip=0; next}
        skip {skip=0}
        {print}
    ' "$IFACES" > "$tmp"
    {
        echo ""
        echo "auto $iface"
        if [ "$mode" = "static" ]; then
            echo "iface $iface inet static"
            echo "	address $3"
            [ -n "$4" ] && echo "	netmask $4"
            [ -n "$5" ] && echo "	gateway $5"
        else
            echo "iface $iface inet dhcp"
            if [ -d "/sys/class/net/$iface/wireless" ] || [ "$iface" = "wlan0" ]; then
                echo "	pre-up wpa_supplicant -B -i $iface -c $WPA 2>/dev/null || true"
                echo "	post-down killall wpa_supplicant 2>/dev/null || true"
            fi
        fi
    } >> "$tmp"
    mv "$tmp" "$IFACES"
    # Aplicar YA: antes solo se aplicaba al reiniciar, y el usuario veia que
    # configuraba una IP y la placa seguia con la anterior (reportado en placa).
    if [ -z "${GALILEOSETUP_ETC:-}" ]; then
        ifdown "$iface" >/dev/null 2>&1
        ifup "$iface" >/dev/null 2>&1
    fi
}

iface_list() {
    for i in $(ls /sys/class/net 2>/dev/null); do
        case "$i" in lo|sit0|tunl0|ip6tnl0) continue ;; esac
        echo "$i"
    done
}

show_status_text() {
    printf 'kernel  : %s\n' "$(uname -r)"
    printf 'host    : %s\n' "$(cat "$HOSTFILE" 2>/dev/null)"
    printf 'uptime  : %ss\n' "$(cut -d. -f1 /proc/uptime 2>/dev/null)"
    printf 'time    : %s\n' "$(date 2>/dev/null)"
    printf 'timezone: %s\n' "$(cat "$TZFILE" 2>/dev/null || echo '(not set)')"
    printf 'memory  : %s MB free\n' "$(free -m 2>/dev/null | awk '/^Mem:/{print $7}')"
    echo
    printf '%-8s %-10s %s\n' IFACE STATE ADDRESS
    for i in $(iface_list); do
        st=$(cat "/sys/class/net/$i/operstate" 2>/dev/null)
        ad=$(ip -4 -o addr show dev "$i" 2>/dev/null | awk '{print $4}' | tr '\n' ' ')
        printf '%-8s %-10s %s\n' "$i" "${st:-?}" "${ad:-—}"
    done
    echo
    echo "WiFi networks saved:"
    if [ -r "$WPA" ]; then
        grep -E 'ssid=' "$WPA" 2>/dev/null | sed 's/^[[:space:]]*/  /' || echo "  (none)"
    else
        echo "  (no wpa_supplicant.conf yet)"
    fi
}


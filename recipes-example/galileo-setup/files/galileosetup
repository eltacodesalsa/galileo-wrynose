PICK=0
# Repinta UNA fila de opcion en su sitio (estilo newt): asi moverse por el menu
# manda ~160 bytes en vez de ~2 KB. A 115200 eso es la diferencia entre
# respuesta instantanea y un barrido visible.
repaint_item() {   # $1 indice ; $2 texto del item ; $3 hl|plain
    # OJO: dentro de la funcion $1/$2 son SUS argumentos, no los del menu; el
    # texto se pasa explicito (antes se hacia eval y pintaba el indice como texto).
    _lbl=$(printf "    %d) %s" "$1" "$2")
    printf "[%d;1H" "$((_base + $1 - 1))"     # _base ya es la fila de la opcion 1
    if [ "$3" = hl ]; then
        printf "###   |%s[7m%s%s[0m|   ###" "$ESC" "$(pad "$_lbl")" "$ESC"
    else
        printf "###   |%s|   ###" "$(pad "$_lbl")"
    fi
}

# Repinta el titulo (se usa para el contador "12/23" al desplazar la lista).
repaint_title() {
    printf "\033[%d;1H" "$TITLE_ROW"
    _padn=$(( (PAD - ${#1}) / 2 ))
    _c=$(printf '%*s%s%*s' "$_padn" '' "$1" $(( PAD - _padn - ${#1} )) '')
    printf "###   |%s|   ###" "$(pad "$_c")"
}

# Pinta una fila de la ventana visible.
# $1 = fila visible (1..maxv) ; $2 = indice real ; $3 = texto ; $4 = hl|plain
pinta_fila() {
    printf "[%d;1H" "$((_base + $1 - 1))"
    _lbl=$(printf "    %d) %s" "$2" "$3")
    if [ "$4" = hl ]; then
        printf "###   |%s[7m%s%s[0m|   ###" "$ESC" "$(pad "$_lbl")" "$ESC"
    else
        printf "###   |%s|   ###" "$(pad "$_lbl")"
    fi
}

menu_pick() {   # $1 titulo ; resto = items -> PICK (0 = back/quit)
    _titulo="$1"; shift
    _n=$#
    _sel=1
    _top=1
    setup_geom
    # Alto FIJO: la lista se desplaza dentro del recuadro en vez de estirarlo.
    # header gasta 11 filas y footer 5. Se deja UNA fila de margen: si el recuadro
    # mide exactamente ROWS, el salto de linea final hace scroll y todas las
    # coordenadas absolutas quedan corridas una fila (titulo y opcion 1 duplicados).
    _maxv=$((ROWS - 17))
    [ "$_maxv" -lt 3 ] && _maxv=3
    [ "$_maxv" -gt "$_n" ] && _maxv=$_n
    header "$_titulo"
    _base=$((ROW + 1))
    _i=1
    while [ "$_i" -le "$_maxv" ]; do
        eval "_txt=\${$_i}"
        _lbl=$(printf "    %d) %s" "$_i" "$_txt")
        if [ "$_i" = "$_sel" ]; then hilite "$_lbl"; else plain "$_lbl"; fi
        _i=$((_i + 1))
    done
    footer
    [ "$_n" -gt "$_maxv" ] && repaint_title "$_titulo  [$_sel/$_n]"
    while :; do
        case "$(read_key)" in
            up)   if [ "$_sel" -le 1 ]; then _new=$_n; else _new=$((_sel - 1)); fi ;;
            down) if [ "$_sel" -ge "$_n" ]; then _new=1; else _new=$((_sel + 1)); fi ;;
            enter) PICK=$_sel; return 0 ;;
            esc|q|quit|eof) PICK=0; return 0 ;;
            *) continue ;;
        esac
        _old=$_sel; _sel=$_new
        _oldtop=$_top
        # mantener la seleccion dentro de la ventana
        if [ "$_sel" -lt "$_top" ]; then _top=$_sel; fi
        if [ "$_sel" -ge $((_top + _maxv)) ]; then _top=$((_sel - _maxv + 1)); fi
        if [ "$_top" != "$_oldtop" ]; then
            # se desplazo: repintar la ventana completa
            _i=1
            while [ "$_i" -le "$_maxv" ]; do
                _abs=$((_top + _i - 1))
                eval "_txt=\${$_abs}"
                if [ "$_abs" = "$_sel" ]; then pinta_fila "$_i" "$_abs" "$_txt" hl
                else pinta_fila "$_i" "$_abs" "$_txt" plain; fi
                _i=$((_i + 1))
            done
            [ "$_n" -gt "$_maxv" ] && repaint_title "$_titulo  [$_sel/$_n]"
        else
            # sin desplazamiento: solo las dos filas afectadas
            eval "_told=\${$_old}"; eval "_tnew=\${$_sel}"
            pinta_fila "$((_old - _top + 1))" "$_old" "$_told" plain
            pinta_fila "$((_sel - _top + 1))" "$_sel" "$_tnew" hl
            [ "$_n" -gt "$_maxv" ] && repaint_title "$_titulo  [$_sel/$_n]"
        fi
    done
}


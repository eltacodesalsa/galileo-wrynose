#!/bin/sh
# galileosetup — multi-screen setup utility for the Intel Galileo Gen 2 /
# Siemens SIMATIC IOT2000 (Intel Quark X1000).
# Project: galileo-wrynose · License: MIT · Version 0.2
#
# Dependency-free (no snack, no mraa, no Python): plain shell + ANSI escapes.
# GPIO/PWM are deliberately out of scope: mraa assumed the kernel 4.4 pin
# numbering and modern kernels expose dynamic gpiochips, so such a tool would
# silently lie.
#
# Interactive:   galileosetup
# Scriptable:    galileosetup --status
#                galileosetup --hostname NAME
#                galileosetup --password 'secret'
#                galileosetup --tz COUNTRY|ZONE
#                galileosetup --wifi SSID PASSPHRASE
#                galileosetup --eth dhcp [IFACE]
#                galileosetup --eth IP [SUBNET] [GATEWAY] [IFACE]
#                galileosetup --serial rs232|rs422|rs485
#
# GALILEOSETUP_ETC overrides /etc (used for tests: nothing real is touched).

VERSION="0.2"
ETC="${GALILEOSETUP_ETC:-/etc}"
ZONEINFO="${GALILEOSETUP_ZONEINFO:-/usr/share/zoneinfo}"
IFACES="$ETC/network/interfaces"
WPA="$ETC/wpa_supplicant.conf"
HOSTFILE="$ETC/hostname"
TZFILE="$ETC/timezone"
LOCALTIME="$ETC/localtime"
STAMP="$(date +%Y%m%d-%H%M%S 2>/dev/null || echo manual)"
TTY=/dev/tty
ESC=$(printf '\033')
# OJO: $(printf '\n') es VACIO (la sustitucion de comandos come el salto final).
# Para tener los caracteres reales se usa el truco del centinela.
NL=$(printf '\nx'); NL=${NL%x}
CR=$(printf '\rx'); CR=${CR%x}
DEL=$(printf '\177x'); DEL=${DEL%x}
BS=$(printf '\bx'); BS=${BS%x}

red()   { printf '\033[1;31m%s\033[0m\n' "$*"; }
green() { printf '\033[1;32m%s\033[0m\n' "$*"; }
blue()  { printf '\033[1;34m%s\033[0m\n' "$*"; }

# ---------------------------------------------------------------- terminal ---
# CLAVE: nunca capturar un byte con $(dd ...) — la sustitución de comandos borra
# los saltos de línea finales, así que Enter (0x0a) se convierte en cadena vacía
# y se pierde. Medido: x=$(printf '\n') -> longitud 0. Por eso se lee SIEMPRE por
# tubería a od y se compara en HEXADECIMAL.
_stty_save=""
RAW=0
# Cada llamada a stty usa TCSAFLUSH: descarta lo que el usuario ya tecleo. Por eso
# ambas son IDEMPOTENTES y no se llama stty si ya estamos en el modo pedido.
raw_on() {
    [ -r "$TTY" ] || return 1
    [ "$RAW" = 1 ] && return 0
    [ -z "$_stty_save" ] && _stty_save=$(stty -g < "$TTY" 2>/dev/null)
    stty -icanon -echo min 1 time 0 < "$TTY" 2>/dev/null
    printf '\033[?25l'      # oculta el cursor
    RAW=1
}
raw_off() {
    [ "$RAW" = 0 ] && return 0
    [ -n "$_stty_save" ] && stty "$_stty_save" < "$TTY" 2>/dev/null
    RAW=0
}
raw_restore() {
    printf '\033[?25h'      # devuelve el cursor al shell
    raw_off
    _stty_save=""
}

# read_byte -> BYTE_HEX : "0a", "1b", "71"… o "" si no hay datos.
# NO se usa 'od -An -tx1': el od de busybox de la imagen se compilo SIN -A ni -t
# (usage: od [-abcdeFfhiloxsv]) y fallaba con "invalid option -- 'A'".
# 'od -x' existe en todas las versiones: imprime "0000000 000a" y el byte esta en
# el campo 2 (2 bytes hex, el valor en la mitad baja).
read_byte() {
    _h=$(dd if="$TTY" bs=1 count=1 2>/dev/null | od -x 2>/dev/null | awk 'NR==1{print $2}')
    case "$_h" in
        "")              BYTE_HEX="" ;;                  # sin datos / EOF
        *[!0-9a-fA-F]*)  BYTE_HEX="" ;;                  # salida no reconocida
        *)               BYTE_HEX=$(printf '%02x' "$((0x$_h))") ;;
    esac
}

# hex_to_char 61 -> "a"  (para reconstruir caracteres imprimibles)
hex_to_char() {
    printf "\\$(printf '%03o' $((0x$1)))"
}

# up down left right enter tab backspace esc quit eof other
read_key() {
    read_byte
    case "$BYTE_HEX" in
        0a|0d) echo enter ;;
        09)    echo tab ;;
        7f|08) echo backspace ;;
        71|51) echo quit ;;                       # q Q
        1b)    # ESC: ventana corta (VTIME) para el resto de la secuencia
               stty min 0 time 1 < "$TTY" 2>/dev/null
               read_byte; _a="$BYTE_HEX"
               read_byte; _b="$BYTE_HEX"
               stty min 1 time 0 < "$TTY" 2>/dev/null
               case "$_a$_b" in
                   5b41|4f41) echo up ;;
                   5b42|4f42) echo down ;;
                   5b43|4f43) echo right ;;
                   5b44|4f44) echo left ;;
                   "")        echo esc ;;
                   *)         echo other ;;
               esac ;;
        "") echo eof ;;
        *)  echo other ;;
    esac
}

# ---------------------------------------------------------------- geometry ---
W=80; PAD=66; ART=simple; ROWS=24
setup_geom() {
    # Cacheado: 'stty size' en cada redibujo abria el tty entre campo y campo y
    # descartaba lo tecleado por adelantado (medido: el 2o campo secreto salia vacio).
    [ -n "${_GEOM_LISTA:-}" ] && return 0
    _GEOM_LISTA=1
    _sz=$(stty size < "$TTY" 2>/dev/null)
    ROWS=${_sz% *}; COLS=${_sz#* }
    case "$ROWS" in ''|*[!0-9]*) ROWS=24 ;; esac
    case "$COLS" in ''|*[!0-9]*) COLS=80 ;; esac
    [ "$ROWS" -ge 10 ] 2>/dev/null || ROWS=24
    [ "$COLS" -ge 40 ] 2>/dev/null || COLS=80
    W=80; PAD=66; ART=simple
    if [ "$COLS" -ge 90 ] && [ "$ROWS" -ge 28 ]; then W=90; PAD=76; ART=full; fi
    if [ "$ROWS" -lt 22 ]; then ART=none; fi
    FRAME=$(printf '%*s' "$W" '' | tr ' ' '#')
    RULE=$(printf '%*s' $((W - 12)) '' | tr ' ' '-')
}

# ----------------------------------------------------------------- drawing ---
ROW=0
emit() { printf '%s\n' "$1"; ROW=$((ROW + 1)); }
blankrow() { emit "###$(printf "%$((W - 6))s" '')###"; }
pad()  { printf "%-${PAD}s" "$1"; }
plain()  { emit "###   |$(pad "$1")|   ###"; }
hilite() { emit "###   |${ESC}[7m$(pad "$1")${ESC}[0m|   ###"; }

header() {   # $1 = screen title
    # Estilo newt: NO se borra la pantalla (eso produce el destello y manda 2 KB
    # por tecla a 115200). Se lleva el cursor al inicio y se sobrescribe.
    [ -t 1 ] && printf '\033[H' 
    ROW=0
    setup_geom
    emit "$FRAME"
    case "$ART" in
        full)
            emit "###    █████████    █████████   █████       █████ █████       ██████████    ███████    ###"
            emit "###   ███░░░░░███  ███░░░░░███ ░░███       ░░███ ░░███       ░░███░░░░░█  ███░░░░░███  ###"
            emit "###  ███     ░░░  ░███    ░███  ░███        ░███  ░███        ░███  █ ░  ███     ░░███ ###"
            emit "### ░███          ░███████████  ░███        ░███  ░███        ░██████   ░███      ░███ ###"
            emit "### ░███    █████ ░███░░░░░███  ░███        ░███  ░███        ░███░░█   ░███      ░███ ###"
            emit "### ░░███  ░░███  ░███    ░███  ░███      █ ░███  ░███      █ ░███ ░   █░░███     ███  ###"
            emit "###  ░░█████████  █████   █████ ███████████ █████ ███████████ ██████████ ░░░███████░   ###"
            emit "###   ░░░░░░░░░  ░░░░░   ░░░░░ ░░░░░░░░░░░ ░░░░░ ░░░░░░░░░░░ ░░░░░░░░░░    ░░░░░░░     ###" ;;
        simple)
            emit "###            ______ _______        _____        _______  _____             ###"
            emit "###           |  ____ |_____| |        |   |      |______ |     |            ###"
            emit "###           |_____| |     | |_____ __|__ |_____ |______ |_____|            ###" ;;
        none) : ;;
    esac
    blankrow
    _t="SETUP UTILITY"; _padn=$(( (W - 6 - ${#_t}) / 2 ))
    emit "###$(printf '%*s%s%*s' "$_padn" '' "$_t" $(( W - 6 - _padn - ${#_t} )) '')###"
    blankrow
    emit "###   $RULE   ###"
    _padn=$(( (PAD - ${#1}) / 2 ))
    TITLE_ROW=$((ROW + 1))
    plain "$(printf '%*s%s%*s' "$_padn" '' "$1" $(( PAD - _padn - ${#1} )) '')"
    emit "###   $RULE   ###"
    emit "###   |$(pad '')|   ###"
}

footer() {
    emit "###   |$(pad '')|   ###"
    emit "###   $RULE   ###"
    blankrow
    emit "$FRAME"
    case "$ART" in
        none) printf "%-80s\n" "  up/down move | Enter select | q quit" ;;
        *)    printf "%-80s\n" "   up/down move   |   Enter select   |   q quit" ;;
    esac
    [ -t 1 ] && printf '\033[J'     # borra lo que sobre por debajo
}

# Record where a field value starts so we can put the cursor there.
FIELD_ROW=0
# field <label> <valor> <plain|secret> [hl] : dibuja una fila de campo.
field() {   # $1 label, $2 valor, $3 plain|secret, $4 hl
    # Ancho a prueba de etiquetas largas: la etiqueta se RECORTA a 12 (%-12.12s)
    # y el relleno se calcula con el espacio que queda. Antes un label de 18
    # caracteres desbordaba la linea y rompia el recuadro.
    _lbl=$(printf "%-12.12s" "$1:")
    _val="$2"; [ "$3" = secret ] && _val=$(printf "%*s" "${#2}" "" | tr " " "*")
    _w=$((PAD - 17))                       # 4 margen + 12 etiqueta + 1 sep
    [ "${#_val}" -gt "$_w" ] && _val=$(printf "%s" "$_val" | cut -c1-"$_w")
    _fill=$(printf "%*s" $((_w - ${#_val})) "" | tr " " "_")
    FIELD_ROW=$((ROW + 1))
    _c=$(printf "    %-12s %s" "$_lbl" "$_val$_fill")
    _c=$(printf "%-${PAD}.${PAD}s" "$_c")
    if [ "$4" = hl ]; then
        emit "###   |${ESC}[7m${_c}${ESC}[0m|   ###"
    else
        emit "###   |${_c}|   ###"
    fi
}


# --------------------------------------------------------------- utilities ---
ensure_dir() { mkdir -p "$(dirname "$1")" 2>/dev/null; }
backup() {
    ensure_dir "$1"; [ -f "$1" ] || return 0
    cp -p "$1" "$1.bak-$STAMP" 2>/dev/null && printf '  backup: %s.bak-%s\n' "$1" "$STAMP"
}

ip_valid() {
    echo "$1" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' || return 1
    _ifs=$IFS; IFS=.; set -- $1; IFS=$_ifs
    [ $# -eq 4 ] || return 1
    for o in "$@"; do [ "$o" -le 255 ] 2>/dev/null || return 1; done
    return 0
}


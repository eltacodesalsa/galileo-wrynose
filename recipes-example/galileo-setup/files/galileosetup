form_begin() {
    FTIT="$1"; shift
    rm -rf "$FDIR"; mkdir -p "$FDIR"
    FLBLS=""
    NFIELDS=0
    for _pair in "$@"; do
        FLBLS="$FLBLS${_pair%%|*}
"
        NFIELDS=$((NFIELDS + 1))
        printf '%s\n' "${_pair#*|}" > "$FDIR/$NFIELDS"
    done
}

label_n() { printf '%s\n' "$FLBLS" | sed -n "${1}p"; }
value_n() { cat "$FDIR/$1" 2>/dev/null; }

buttons_row() {   # 0 = sin foco | 1 = OK | 2 = CANCEL
    if [ "$1" = 0 ]; then
        _a="$(printf '%-32s' '             OK')"
        _b="$(printf '%-33s' '            CANCEL')"
    elif [ "$1" = 1 ]; then
        _a="${ESC}[7m$(printf '%-32s' '             OK')${ESC}[0m"
        _b="$(printf '%-33s' '            CANCEL')"
    else
        _a="$(printf '%-32s' '             OK')"
        _b="${ESC}[7m$(printf '%-33s' '            CANCEL')${ESC}[0m"
    fi
    emit "###   |${_a}|${_b}|   ###"
}

form_draw() {   # redibuja con los valores actuales y el FOCO
    header "$FTIT"
    _i=1
    while [ "$_i" -le "$NFIELDS" ]; do
        _modo=plain
        is_secret "$_i" && _modo=secret
        if [ "$FOCUS" = "$_i" ]; then
            field "$(label_n "$_i")" "$(value_n "$_i")" "$_modo" hl
        else
            field "$(label_n "$_i")" "$(value_n "$_i")" "$_modo"
        fi
        eval "FROW_$_i=$FIELD_ROW"
        _i=$((_i + 1))
    done
    emit "###   |$(pad "")|   ###"
    emit "###   $RULE   ###"
    if [ "$FOCUS" -gt "$NFIELDS" ]; then buttons_row "$BTN"; else buttons_row 0; fi
    emit "###   $RULE   ###"
    emit "###$(printf "%$((W - 6))s" "")###"
    emit "$FRAME"
    printf "%-80s\n" "   up/down move | Enter edit/accept | Tab next | left/right buttons | Esc"
}

# read_secret -> REPLY : lee en modo crudo y muestra '*' por caracter.
# No se usa stty -echo: usa TCSAFLUSH y descarta la entrada pendiente (medido:
# el campo salia vacio y el script se quedaba esperando). Tampoco queda nada en
# pantalla ni en el historial del terminal.
# read_field -> REPLY : editor de linea minimo. Eco normal, Backspace borra,
# TAB/Enter terminan, y las SECUENCIAS DE ESCAPE (flechas, etc.) se DESCARTAN:
# con "read -r" en modo cocido se escribian como ^[[A dentro del campo.
read_field() {
    raw_on
    _s="$1"
    [ -n "$_s" ] && printf "%s" "$_s"
    while :; do
        read_byte
        case "$BYTE_HEX" in
            ""|0a|0d) break ;;
            09) break ;;                        # TAB = terminar campo
            03) REPLY=""; return 1 ;;          # Ctrl-C
            7f|08)
                if [ -n "$_s" ]; then
                    _s=$(printf "%s" "$_s" | sed "s/.$//")
                    printf "\b \b"
                fi ;;
            1b)
                # consumir la secuencia completa hasta su terminador o 0.1 s
                stty min 0 time 1 < "$TTY" 2>/dev/null
                while :; do
                    read_byte
                    [ -z "$BYTE_HEX" ] && break
                    case "$BYTE_HEX" in 41|42|43|44|48|46|7e|7d|7c) break ;; esac
                done
                stty min 1 time 0 < "$TTY" 2>/dev/null ;;
            *)
                # solo ASCII imprimible: evita que entren controles al campo
                case "$BYTE_HEX" in
                    2[0-9a-f]|3[0-9a-f]|4[0-9a-f]|5[0-9a-f]|6[0-9a-f]|7[0-9a-e])
                        _ch=$(hex_to_char "$BYTE_HEX")
                        _s="$_s$_ch"; printf "%s" "$_ch" ;;
                esac ;;
        esac
    done
    REPLY="$_s"
    return 0
}

read_secret() {   # -> REPLY : lee en crudo, muestra * por caracter
    raw_on
    _s=""
    while :; do
        read_byte
        case "$BYTE_HEX" in
            ""|0a|0d) break ;;                  # EOF o Enter: fin
            09)       break ;;                  # TAB: fin del campo (no se guarda)
            03)       break ;;                  # Ctrl-C
            7f|08)                              # Backspace
                if [ -n "$_s" ]; then
                    _s=$(printf '%s' "$_s" | sed 's/.$//')
                    printf '\b \b'
                fi ;;
            1b)                                 # ESC y flechas: DESCARTAR la secuencia
                stty min 0 time 1 < "$TTY" 2>/dev/null
                while :; do
                    read_byte
                    [ -z "$BYTE_HEX" ] && break
                    case "$BYTE_HEX" in 41|42|43|44|48|46|7e|7d|7c) break ;; esac
                done
                stty min 1 time 0 < "$TTY" 2>/dev/null ;;
            *)
                # solo ASCII imprimible (0x20-0x7e): nada de controles ni DEL
                case "$BYTE_HEX" in
                    2[0-9a-f]|3[0-9a-f]|4[0-9a-f]|5[0-9a-f]|6[0-9a-f]|7[0-9a-e])
                        _s="$_s$(hex_to_char "$BYTE_HEX")"
                        printf '*' ;;
                esac ;;
        esac
    done
    REPLY="$_s"
}

# edit_n <n> : puts the cursor on field n and reads a new value.
# edit_n <n> : pone el cursor en el campo n y lee un valor nuevo.
# En campos secretos NO se cambia el modo del terminal (ya estamos en crudo):
# cada stty extra descartaria lo que el usuario ya tecleo.
edit_n() {
    eval "_r=\$FROW_$1"
    if is_secret "$1"; then
        printf "\033[%d;25H" "$_r"; printf "\033[K"
        read_secret
        _v="$REPLY"
    else
        printf "\033[%d;25H" "$_r"; printf "\033[K"
        read_field "$(cat "$FDIR/$1" 2>/dev/null)"
        _v="$REPLY"
    fi
    _v=$(printf "%s" "$_v" | tr -d "\000-\037\177" | sed "s/^ *//; s/ *$//")
    [ -n "${GALILEOSETUP_DEBUG:-}" ] && printf "campo %s = [%s]\n" "$1" "$_v" >> "$GALILEOSETUP_DEBUG"
    [ -n "$_v" ] && printf "%s\n" "$_v" > "$FDIR/$1"
}

# form_run -> FORM_RESULT=ok|cancel ; valores en value_n
form_run() {   # -> FORM_RESULT=ok|cancel ; valores en value_n
    form_begin "$@"
    FORM_RESULT=cancel
    FOCUS=1
    BTN=1
    form_draw
    while :; do
        case "$(read_key)" in
            up)
                if [ "$FOCUS" -gt 1 ] && [ "$FOCUS" -le "$NFIELDS" ]; then
                    FOCUS=$((FOCUS - 1))
                elif [ "$FOCUS" -gt "$NFIELDS" ]; then
                    FOCUS=$NFIELDS
                fi
                form_draw ;;
            down|tab)
                # -le: desde el ULTIMO campo se baja a la fila de botones (NFIELDS+1)
                if [ "$FOCUS" -le "$NFIELDS" ]; then FOCUS=$((FOCUS + 1)); fi
                form_draw ;;
            left)  if [ "$FOCUS" -gt "$NFIELDS" ]; then BTN=1; form_draw; fi ;;
            right) if [ "$FOCUS" -gt "$NFIELDS" ]; then BTN=2; form_draw; fi ;;
            enter)
                if [ "$FOCUS" -le "$NFIELDS" ]; then
                    edit_n "$FOCUS"
                    form_draw
                elif [ "$BTN" = 1 ]; then
                    FORM_RESULT=ok; return 0
                else
                    FORM_RESULT=cancel; return 0
                fi ;;
            esc|q|quit|eof) FORM_RESULT=cancel; return 0 ;;
        esac
    done
}

is_secret() { case " ${GALILEOSETUP_SECRET_FIELDS:-} " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# Mensaje de estado: se pinta en la ULTIMA fila (la del aviso de teclas), que es
# la unica libre; antes escribia donde quedaba el cursor y se empalmaba sobre el
# recuadro. Al terminar se restaura el aviso.
message() {
    _r=$ROWS
    printf "[%d;1H[K" "$_r"
    printf "  %s   (Enter)" "$1"
    read_key >/dev/null 2>&1      # cualquier tecla; en crudo, sin stty (evita el flush)
    printf "[%d;1H[K" "$_r"
    case "$ART" in
        none) printf "%-80s\n" "  up/down move | Enter select | q quit" ;;
        *)    printf "%-80s\n" "   up/down move   |   Enter select   |   q quit" ;;
    esac
}

# ------------------------------------------------------------------ screens ---
screen_main() {
    while :; do
        menu_pick "MAIN MENU" "OS Settings" "Network configuration" "System status" "Reboot device" "Exit"
        case "$PICK" in
            1) screen_os ;;
            2) screen_network ;;
            3) screen_status ;;
            4) do_reboot ;;
            0|5) raw_restore; [ -t 1 ] && clear; exit 0 ;;
        esac
    done
}

# ---------------------------------------------------------------- reiniciar ---
do_reboot() {
    menu_pick "REBOOT DEVICE" "No, go back" "Yes, reboot now"
    case "$PICK" in
        2)
            raw_restore
            [ -t 1 ] && clear
            printf 'Rebooting now...\n'
            sync
            # 'reboot now' en una placa con watchdog: si el apagado ordenado no
            # arranca en 5 s, se fuerza para no quedarse colgado.
            ( sleep 5; reboot -f 2>/dev/null ) &
            exec reboot now 2>/dev/null || exec reboot -f 2>/dev/null || exec reboot
            ;;
        *) : ;;   # volver al menu
    esac
}

# ------------------------------------------------------------- fecha y hora ---
do_datetime() {   # $1 = YYYY-MM-DD ; $2 = HH:MM[:SS]
    case "$1" in
        [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;;
        *) return 1 ;;
    esac
    case "$2" in
        [0-9][0-9]:[0-9][0-9]) _2="$2:00" ;;
        [0-9][0-9]:[0-9][0-9]:[0-9][0-9]) _2="$2" ;;
        *) return 1 ;;
    esac
    seg=$(echo "$1" | cut -d- -f1); mes=$(echo "$1" | cut -d- -f2); dia=$(echo "$1" | cut -d- -f3)
    [ "$mes" -ge 1 ] && [ "$mes" -le 12 ] || return 1
    [ "$dia" -ge 1 ] && [ "$dia" -le 31 ] || return 1
    hh=$(echo "$_2" | cut -d: -f1); mm=$(echo "$_2" | cut -d: -f2); ss=$(echo "$_2" | cut -d: -f3)
    [ "$hh" -le 23 ] && [ "$mm" -le 59 ] && [ "$ss" -le 59 ] || return 1
    [ -f "$ETC/date.set" ] && backup "$ETC/date.set"
    date -s "$1 $_2" >/dev/null 2>&1 || return 1
    # dejar constancia y, si hay RTC, escribirlo
    printf '%s %s\n' "$1" "$_2" > "$ETC/date.set" 2>/dev/null
    [ -e /dev/rtc0 ] && hwclock -w >/dev/null 2>&1
    return 0
}

do_ntp() {   # sincroniza por red; devuelve 0 si funciono
    [ -f "$ETC/ntp.log" ] && backup "$ETC/ntp.log"
    _ok=1
    if command -v ntpd >/dev/null 2>&1; then
        ntpd -q -n -p pool.ntp.org >"$ETC/ntp.log" 2>&1 && _ok=0
    fi
    if [ "$_ok" != 0 ] && command -v rdate >/dev/null 2>&1; then
        rdate -s pool.ntp.org >>"$ETC/ntp.log" 2>&1 && _ok=0
    fi
    [ "$_ok" = 0 ] && [ -e /dev/rtc0 ] && hwclock -w >/dev/null 2>&1
    return "$_ok"
}

# Formulario de fecha y hora, con los valores actuales precargados.
screen_datetime() {
    _hoy=$(date +%Y-%m-%d 2>/dev/null)
    _ahora=$(date +%H:%M:%S 2>/dev/null)
    GALILEOSETUP_SECRET_FIELDS=""
    form_run "DATE AND TIME (YYYY-MM-DD HH:MM:SS)" "Date|$_hoy" "Time|$_ahora"
    [ "$FORM_RESULT" = ok ] || return 0
    _d=$(value_n 1); _t=$(value_n 2)
    if do_datetime "$_d" "$_t"; then
        message "Clock set to $(date 2>/dev/null)"
    else
        message "Invalid date or time. Use YYYY-MM-DD and HH:MM:SS."
    fi
}

screen_ntp() {
    if do_ntp; then
        message "Clock synced from the network: $(date 2>/dev/null)"
    else
        message "Could not reach an NTP server. Check the network."
    fi
}

screen_os() {
    while :; do
        menu_pick "OS SETTINGS" "Change Hostname" "Change Password" "Change Timezone" \
            "Set Date and Time" "Sync Clock (NTP)" "Back"
        case "$PICK" in
            1) form_hostname ;;
            2) form_password ;;
            3) form_time ;;
            4) screen_datetime ;;
            5) screen_ntp ;;
            0|6) return 0 ;;
        esac
    done
}

screen_status() {
    header "SYSTEM STATUS"
    show_status_text | while IFS= read -r _l; do
        plain "$_l"
    done
    footer
    read_key >/dev/null 2>&1     # cualquier tecla, sin Enter
}

screen_network() {
    while :; do
        menu_pick "NETWORK CONFIGURATION" "Wifi configuration" "Wired Network configuration" "Back"
        case "$PICK" in
            1) form_wifi ;;
            2) screen_wired ;;
            0|3) return 0 ;;
        esac
    done
}

screen_wired() {
    _ifs=$(iface_list)
    _n=$(printf '%s\n' "$_ifs" | grep -c .)
    set -- $_ifs "Back"
    menu_pick "WIRED NETWORK CONFIGURATION" "$@"
    if [ "$PICK" -ge 1 ] && [ "$PICK" -le "$_n" ]; then
        _if=$(printf '%s\n' "$_ifs" | sed -n "${PICK}p")
        form_iface "$_if"
    fi
}

# -------------------------------------------------------------------- forms ---
form_hostname() {
    _cur=$(cat "$HOSTFILE" 2>/dev/null)
    GALILEOSETUP_SECRET_FIELDS=""
    form_run "CHANGE HOSTNAME" "Host Name|$_cur"
    [ "$FORM_RESULT" = ok ] || return 0
    _v=$(value_n 1)
    if [ -z "$_v" ]; then message "Empty hostname: nothing changed."; return 0; fi
    if do_hostname "$_v"; then
        message "Hostname set to '$_v'. Takes effect now and after reboot."
    else
        message "Invalid hostname. Use letters, digits and hyphens."
    fi
}

form_password() {
    GALILEOSETUP_SECRET_FIELDS="1 2"
    form_run "CHANGE PASSWORD" "Password|" "Confirm|"
    GALILEOSETUP_SECRET_FIELDS=""
    [ "$FORM_RESULT" = ok ] || return 0
    _p=$(value_n 1); _c=$(value_n 2)
    if [ -z "$_p" ]; then message "Empty password: nothing changed."; return 0; fi
    if [ "$_p" != "$_c" ]; then message "Passwords do not match. Nothing changed."; return 0; fi
    if do_password "$_p"; then
        message "Root password updated."
    else
        message "Could not set the password (chpasswd failed)."
    fi
}

form_time() {
    GALILEOSETUP_SECRET_FIELDS=""
    screen_tz_country
}

form_wifi() {
    GALILEOSETUP_SECRET_FIELDS="2"
    form_run "WIFI CONFIGURATION" "SSID|" "PW|" "TYPE|WPA-PSK" "IP|dhcp"
    GALILEOSETUP_SECRET_FIELDS=""
    [ "$FORM_RESULT" = ok ] || return 0
    _ssid=$(value_n 1); _psk=$(value_n 2); _ip=$(value_n 4)
    if [ -z "$_ssid" ] || [ -z "$_psk" ]; then message "SSID and password are required."; return 0; fi
    if do_wifi "$_ssid" "$_psk" "$_ip"; then
        message "Network '$_ssid' saved to $WPA (passphrase hashed). Bring wlan0 up to apply."
    else
        message "Could not save the WiFi configuration (is wpa_passphrase installed?)."
    fi
}

form_iface() {
    _if="$1"
    _cur=$(ip -4 -o addr show dev "$_if" 2>/dev/null | awk '{print $4}')
    GALILEOSETUP_SECRET_FIELDS=""
    _gwcur=$(ip route 2>/dev/null | awk '/^default/ {print $3; exit}')
    form_run "IFACE NETWORK CONFIGURATION" "IP|$_cur" "SUBNET|255.255.255.0" "GATEWAY|$_gwcur"
    [ "$FORM_RESULT" = ok ] || return 0
    _ip=$(value_n 1); _mask=$(value_n 2); _gw=$(value_n 3)
    if [ "$_ip" = "dhcp" ]; then
        backup "$IFACES"; set_iface "$_if" dhcp "" "" ""
        message "Set $_if to DHCP in $IFACES."
        return 0
    fi
    if ! ip_valid "${_ip%%/*}"; then message "Invalid IP address: '$_ip'"; return 0; fi
    [ -n "$_gw" ] && ! ip_valid "$_gw" && { message "Invalid gateway: '$_gw'"; return 0; }
    backup "$IFACES"; set_iface "$_if" static "${_ip%%/*}" "$_mask" "$_gw"
    message "Configuration applied: $_if now uses the new settings."
}

# ---------------------------------------------------------------------- cli ---
cli_status() { show_status_text; }

cli_usage() {
    sed -n '12,22p' "$0" | sed 's/^# \{0,1\}//'
}

main() {
    case "${1:-}" in
        "") 
            if [ ! -t 0 ] || [ ! -r "$TTY" ]; then
                echo "galileosetup $VERSION — no terminal available."
                echo "Use --help for the scriptable options."
                return 1
            fi
            trap 'raw_restore' EXIT INT TERM HUP
            raw_on
            screen_main
            raw_restore ;;
        --status|-s) cli_status ;;
        --version|-v) echo "galileosetup $VERSION" ;;
        --hostname) shift; do_hostname "$1" && echo "hostname: $1" || { red "invalid hostname"; return 1; } ;;
        --password) shift; do_password "$1" && echo "password updated" || { red "chpasswd failed"; return 1; } ;;
        --tz-list) shift
               zones_for_country "$1" | while IFS='|' read -r _z _lab; do
                   [ -e "$ZONEINFO/$_z" ] && printf '%-32s %s\n' "$_z" "$_lab"
               done ;;
        --tz) shift
               _z=$(zones_for_country "$1" | head -n 1 | cut -d'|' -f1)
               [ -z "$_z" ] && { red "unknown country/zone: $1"; return 1; }
               _nz=$(zones_for_country "$1" | grep -c .)
               do_timezone "$_z" && echo "timezone: $(cat "$TZFILE")" || { red "could not set $_z"; return 1; }
               [ "$_nz" -gt 1 ] && echo "(that country has $_nz zones; run --tz-list '$1' or use the menu to pick another)" ;;
        --wifi) shift; [ $# -ge 2 ] || { red "usage: --wifi SSID PASSPHRASE"; return 1; }
                do_wifi "$1" "$2" "${3:-dhcp}" && echo "wifi saved" ;;
        --eth) shift
               if [ "$1" = dhcp ]; then
                   _i="${2:-eth0}"; backup "$IFACES"; set_iface "$_i" dhcp "" "" ""; echo "$_i -> dhcp"
               else
                   ip_valid "$1" || { red "invalid IP: $1"; return 1; }
                   _i="${4:-eth0}"; backup "$IFACES"; set_iface "$_i" static "$1" "${2:-255.255.255.0}" "${3:-}"
                   echo "$_i -> static $1"
               fi ;;
        --datetime) shift
            _all="$1"
            case "$_all" in
                *" "*) _d="${_all%% *}"; _t="${_all#* }" ;;      # "fecha hora" junto
                *)     _d="$_all"; _t="${2:-$(date +%H:%M:%S)}"; [ -n "$2" ] && shift ;;
            esac
            shift
            if do_datetime "$_d" "$_t"; then echo "clock: $(date)"; else red "invalid date/time (use YYYY-MM-DD HH:MM[:SS])"; return 1; fi ;;
        --ntp) if do_ntp; then echo "clock: $(date)"; else red "NTP failed (check the network)"; return 1; fi ;;
        --serial) shift; switchmode "$1" && echo "serial: $1" || { red "switchmode failed"; return 1; } ;;
        --help|-h) cli_usage ;;
        *) red "unknown option: $1 (try --help)"; return 1 ;;
    esac
}

main "$@"

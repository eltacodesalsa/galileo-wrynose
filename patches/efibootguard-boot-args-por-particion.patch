 msger = logging.getLogger('wic')
 
+def _galileo_args(cmdline, source_params):
+    """galileo: conservar el resto del cmdline cuando se da 'args'.
+
+    wic mete 'root=PARTLABEL=<raiz>' en el cmdline global. Si 'args' lo
+    reemplazara entero, cada entorno perderia la consola: la coma de
+    console=ttyS1,115200n8 no se puede pasar por --sourceparams porque se
+    separan por comas. Aqui 'args' define solo la raiz y el resto del cmdline
+    (rootwait, consola) se conserva.
+    """
+    args = source_params.get("args")
+    if not args:
+        return cmdline.strip()
+    resto = " ".join(t for t in cmdline.split() if not t.startswith("root=PARTLABEL="))
+    return (args + " " + resto).strip()
+
+
 class EfibootguardBootPlugin(SourcePlugin):

* text=auto eol=lf

*.sh       text eol=lf
*.py       text eol=lf
*.bb       text eol=lf
*.bbappend text eol=lf
*.inc      text eol=lf
*.conf     text eol=lf
*.cfg      text eol=lf
*.wks      text eol=lf
*.service  text eol=lf
*.yml      text eol=lf
*.md       text eol=lf
LICENSE    text eol=lf

# Los parches no se tocan: git no debe normalizar su contenido ni sus finales de
# linea, o dejan de aplicar con git am.
*.patch    -text
*.diff     -text

*.wic      binary
*.bz2      binary

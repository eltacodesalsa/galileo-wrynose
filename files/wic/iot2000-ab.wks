# Galileo Gen 2 (hardware) con el layout A/B de la imagen de Siemens IOT2000.
# 7 particiones: efi · boot0 · boot1 · platform0 · platform1 · swap · persistent
#
# boot0 es el entorno activo (revision 2) y boot1 el respaldo (revision 1).
# Las DOS raices llevan el sistema: platform1 se genera con --source rootfs,
# porque si se deja solo formateada el respaldo hace panic con
# "No working init found" (comprobado en la placa).

part --source efibootguard-efi  --size 32   --extra-space 0 --overhead-factor 1 --ondisk mmcblk0 --label efi       --part-type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B --align 1024
part --source efibootguard-boot --size 32   --extra-space 0 --overhead-factor 1 --ondisk mmcblk0 --label boot0     --part-type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7 --align 1024 --sourceparams "watchdog=60,revision=2,initrd=acpi-upgrades.cpio,args=root=PARTLABEL=platform0"
part --source efibootguard-boot --size 32   --extra-space 0 --overhead-factor 1 --ondisk mmcblk0 --label boot1     --part-type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7 --align 1024 --sourceparams "watchdog=60,revision=1,initrd=acpi-upgrades.cpio,args=root=PARTLABEL=platform1"
part /                          --source rootfs --size 2048 --extra-space 0 --overhead-factor 1 --ondisk mmcblk0 --fstype=ext4 --label platform0 --align 1024
part                            --source rootfs --size 2048 --extra-space 0 --overhead-factor 1 --ondisk mmcblk0 --fstype=ext4 --label platform1 --align 1024
part swap                       --ondisk mmcblk0 --size 512 --fstype=swap --label swap --align 1024
part /data                      --size 1024 --extra-space 0 --overhead-factor 1 --ondisk mmcblk0 --label persistent --align 1024 --fstype=ext4

bootloader --ptable gpt --append="rootwait console=ttyS1,115200n8 earlyprintk"
